{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "claimcheck input, version 1",
  "description": "Structure for analysis or prospective design. Analysis additionally requires shots and successes/mean. The runtime validates numerical ranges, unique ids, support containment and fixed-family consistency.",
  "type": "object", "required": ["settings", "candidates"],
  "properties": {
    "alpha": {"type":"number","exclusiveMinimum":0,"exclusiveMaximum":1},
    "family_size": {"type":"integer","minimum":1},
    "question": {"type":"string"},
    "data_kind": {"enum":["hardware","emulator","synthetic","reference","unspecified"]},
    "data_origin": {"type":"string"},
    "settings": {"type":"array","minItems":1,"items":{"type":"object","required":["id","kind","support"],"properties":{
      "id":{"type":"string","minLength":1},"kind":{"enum":["binomial","bounded_mean"]},
      "support":{"$ref":"#/$defs/interval"},"shots":{"type":"integer","minimum":1},
      "successes":{"type":"integer","minimum":0},"mean":{"type":"number"}
    }}},
    "candidates": {"type":"array","minItems":1,"items":{"type":"object","required":["id","intervals"],"properties":{
      "id":{"type":"string","minLength":1},"set_semantics":{"enum":["outer_box","attainable_product"]},
      "intervals":{"type":"object","minProperties":1,"additionalProperties":{"$ref":"#/$defs/interval"}}
    }}},
    "uncertainty":{"type":"object","required":["status","description"],"properties":{
      "status":{"enum":["assumed","external_bound"]},"description":{"type":"string","minLength":1},
      "failure_probability":{"type":"number","minimum":0,"exclusiveMaximum":1}
    },"allOf":[{"if":{"properties":{"status":{"const":"external_bound"}}},"then":{"required":["failure_probability"]}}]}
  },
  "$defs":{"interval":{"type":"array","minItems":2,"maxItems":2,"items":{"type":"number"}}}
}
